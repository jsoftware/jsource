NB. jvp, vjp and hvp
jvp =: {{ u@(y&+)@(x&*) D.1 ] 0 }}
vjp =: {{ ([: +/ ,@(x * u)) D.1 y }}
hvp =: (D.1) jvp
dirc =: {{ x +/@:,@:*"((#$y),_) y }}
cotc =: {{ +/^:(#$x) x * y }}
NB. u cp y ; v ; w  the three products against the numeric Jacobian and Hessian, in every mode
cp =: {{
 'y d w' =. y
 J =. u NJ y
 r =. ((d u jvp y) ok J dirc d) , ((d u jvp F y) ok J dirc d) , (d u jvp R y) ok J dirc d
 r =. r , ((w u vjp y) ok w cotc J) , ((w u vjp F y) ok w cotc J) , (w u vjp R y) ok w cotc J
 if. 0 = #$ u y do.
  H =. u D.1 NJ y
  for_o. 0 1 _1 do.
   for_i. 0 1 _1 do.
    r =. r , (d (u hvp) Md (o,i) y) ok H dirc d
   end.
  end.
 end.
 *./ r
}}
