prolog './gad.ijs'
NB. Automatic differentiation
NB. [x] u D. n y

NB. display
f =: *: D.2
'*:D.2' -: 5!:5 < 'f'
f =: ([: */D.1 *:) D.2
'([: */D.1 *:)D.2' -: 5!:5 < 'f'

NB. ranks
_ _ _ -: 1&o. D.1 b. 0
1 1 1 -: 1&o."1 D.2 b. 0
0 0 0 -: o. D.2 b. 0

NB. arguments
'domain error' -: ". etx '3 D. 1'
'domain error' -: ". etx '*: D. +'
'rank error' -: ". etx '*: D. 1 2'
'domain error' -: ". etx '*: D. _1'
'limit error' -: ". etx '*: D. 101'
'rank error' -: 9!:_11 etx 2 2 $ 0
'length error' -: 9!:_11 etx 9 $ 0
'domain error' -: 9!:_11 etx 2

NB. utils
NB. u Md n y runs u y with modes n forced.
Md =: {{
 9!:_11 n [ old =. 9!:_10 ''
 try. r =. u y catch. 13!:8 ] 13!:11 '' [ 9!:_11 old end.
 r [ 9!:_11 old
:
 9!:_11 n [ old =. 9!:_10 ''
 try. r =. x u y catch. 13!:8 ] 13!:11 '' [ 9!:_11 old end.
 r [ 9!:_11 old
}}

NB. F and R are adverbs that force forward/reverse everywhere.
F =: Md 1
R =: Md _1

H =: 1e_6

NB. Numeric elementwise derivative of atomic u
NE =: {{ ((u y + H) - u y - H) % +: H }}

NB. Numeric Jacobian of monad u at y, shape ($u y),$y
NJ =: {{
 res =. 0 $ a:
 for_i. i. */@$ y do.
  e =. ($y) $ i = i. */@$ y
  res =. res , < ((u y + H * e) - u y - H * e) % +: H
 end.
 (($ u y) , $y) $ , 0 |: > res
}}

close =: {{ (1e_5 * 1 >. >./ , | y) > >./ , | x - y }}
ok =: 0:`close@.(-:&$)

NB. u cm y
NB. Monad, full Jacobian, u's rank must be non-negative
cm =: {{
 rk =. {. u D. 1 b. 0  NB. D. has the rank of u, one Jacobian per cell
 ref =. u NJ"rk y
 ((u D.1 y) ok ref) , ((u D.1 F y) ok ref) , (u D.1 R y) ok ref
}}

NB. u ce y
NB. Atomic monad, ordinary derivative/diagonal Jacobians.
ce =: {{
 ref =. u NE y
 b =. ((u"0 D.1 y) ok ref) , ((u"0 D.1 F y) ok ref) , (u"0 D.1 R y) ok ref
 rk =. {. u b. 0
 ref =. u NJ"rk y
 b *. ((u D.1 y) ok ref) , ((u D.1 F y) ok ref) , (u D.1 R y) ok ref
}}

NB. x u cdy y
NB. Dyad, Jacobian with respect to y
cdy =: {{
 rk =. }. (u D.1) b. 0
 ref =. x u {{ x&u NJ y }}"rk y
 ((x u D.1 y) ok ref) , ((x u D.1 F y) ok ref) , (x u D.1 R y) ok ref
}}

NB. Monad, second derivative.
c2 =: {{
 rk =. {. (u D.2) b. 0
 if. rk -: 0 do. ref =. u D.1 NE y else. ref =. u D.1 NJ"rk y end.
 b =. (u D.2 y) ok ref
 for_out. 0 1 _1 do.
  for_in. 0 1 _1 do.
   b =. b , (u D.1 D.1 Md (out , in) y) ok ref
  end.
 end.
 *./ b
}}

NB. Monad, third derivative.
c3 =: {{
 rk =. {. u D.3 b. 0
 if. rk -: 0 do. ref =. u D.2 NE y else. ref =. u D.2 NJ"rk y end.
 *./ ((u D.3 y) ok ref) , ((u D.3 F y) ok ref) , ((u D.3 R y) ok ref) , ((u D.1 D.1 D.1) Md _1 1 _1 y) ok ref
}}

NB. Dyad, second derivative.
cdy2 =: {{
 rk =. }. u D.2 b. 0
 ref =. x u D.1 {{ x&u NJ y }}"rk y
 *./ ((x u D.2 y) ok ref) , ((x u D.2 F y) ok ref) , (x u D.2 R y) ok ref
}}

