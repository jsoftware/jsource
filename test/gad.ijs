hf =: {{
 p =. (}. y) * }: y
 o =. (2 o. p) - p * 1 o. p
 s =. 1 o. p
 dg =. 2 - (0 , s * *: }: y) + (s * *: }. y) , 0
 (dg * x) + ((o * }. x) , 0) + 0 , o * }: x
}}
