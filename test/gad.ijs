NB. cof y: exact cofactors, the derivative of the determinant
cof =: {{
 s =. # y [ Y =. x: y
 r =. 0 $ 0
 for_i. i. s do.
  for_j. i. s do.
   r =. r , (_1 ^ i + j) * -/ . * (<<<i) { (<<<j) {"1 Y
  end.
 end.
 (s,s) $ r
}}
